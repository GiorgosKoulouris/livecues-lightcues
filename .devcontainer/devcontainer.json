{
  "name": "lvlc",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "postCreateCommand": "sudo chown node:node node_modules && if [ -f package.json ]; then npm install --prefer-offline --no-audit --no-fund; fi",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "anthropic.claude-code"
      ]
    }
  }
}
