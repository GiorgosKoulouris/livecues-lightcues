.claude/*
# Only the project's own skills are tracked.
!.claude/skills/
.claude/skills/*
!.claude/skills/make-show/
!.claude/skills/light-song/
node_modules/
out/
dist/
fixtures/
/reports/
# Vitest coverage report (npm run coverage).
coverage/
# Playwright output (npm run e2e).
test-results/

temp/

# Impeccable skill install (local tooling; its .claude/ part is ignored above).
.github/skills/impeccable/
.github/agents/impeccable-*.agent.md
.github/hooks/impeccable.json
# Impeccable per-developer settings. The rest of .impeccable/ is shared.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json

# Local issues and specs
.scratch/

# Show Generator briefs and their output (bands/<Band>/).
bands/
