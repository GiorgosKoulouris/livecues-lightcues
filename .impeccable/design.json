      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:1px solid transparent;border-radius:6px;font:500 14px/1.4 'Segoe UI Variable Text','Segoe UI',system-ui,sans-serif;white-space:nowrap;cursor:pointer;transition:background 120ms,border-color 120ms;}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 2px #0e1014,0 0 0 4px #5b9dff;}.ds-btn-secondary{background:#1c2028;border-color:#2f3541;color:#e3e6eb;}.ds-btn-secondary:hover{background:#262b35;border-color:#444c5b;}.ds-btn-secondary:active{background:#15181e;}"
