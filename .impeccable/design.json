      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border:1px solid transparent;border-radius:6px;font:500 14px/1.4 'Segoe UI Variable Text','Segoe UI',system-ui,sans-serif;white-space:nowrap;cursor:pointer;transition:background 120ms,border-color 120ms;}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 2px #0e1014,0 0 0 4px #5b9dff;}.ds-btn-danger{background:#ff4d4f;color:#0e1014;}.ds-btn-danger:hover{background:#ff6b6d;}"
    },
    {
      "name": "Scene Button",
      "kind": "custom",
      "refersTo": "scene-button",
      "description": "A Perform Scene button with its key hint; live state is a green outline, soft green fill and dot.",
      "html": "<div class=\"ds-scenes\"><button class=\"ds-scene\" aria-pressed=\"true\"><span class=\"ds-scene-name\"><span class=\"ds-dot\"></span>Verse: warm, amber centre</span><span class=\"ds-key\">2</span></button><button class=\"ds-scene\" aria-pressed=\"false\"><span class=\"ds-scene-name\">Chorus: full red</span><span class=\"ds-key\">3</span></button></div>",
      "css": ".ds-scenes{display:grid;grid-template-columns:repeat(2,160px);gap:8px;}.ds-scene{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:52px;padding:8px 12px;border:1px solid #2f3541;border-radius:6px;background:#1c2028;color:#e3e6eb;font:500 14px/1.4 'Segoe UI Variable Text','Segoe UI',system-ui,sans-serif;text-align:left;cursor:pointer;transition:background 120ms,border-color 120ms;}.ds-scene:hover{background:#262b35;border-color:#444c5b;}.ds-scene:focus-visible{outline:none;box-shadow:0 0 0 2px #0e1014,0 0 0 4px #5b9dff;}.ds-scene[aria-pressed=true]{border-color:#3ddc97;box-shadow:inset 0 0 0 1px #3ddc97;background:rgb(61 220 151 / 16%);}.ds-scene-name{display:flex;align-items:center;gap:8px;}.ds-dot{width:8px;height:8px;border-radius:999px;background:#3ddc97;flex-shrink:0;}.ds-key{padding:0 4px;border:1px solid var(--border-strong,#444c5b);border-radius:4px;color:var(--text-muted,#9aa2b1);font-size:11px;font-weight:500;line-height:16px;}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled input; mono for DMX addresses.",
      "html": "<label class=\"ds-field\"><span class=\"ds-label\">DMX address</span><input class=\"ds-input\" value=\"101\"><span class=\"ds-hint\">1–512</span></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;width:200px;font-family:'Segoe UI Variable Text','Segoe UI',system-ui,sans-serif;}.ds-label{color:#9aa2b1;font-size:12px;font-weight:500;}.ds-hint{color:#6b7383;font-size:12px;}.ds-input{height:32px;padding:0 8px;border:1px solid #2f3541;border-radius:6px;background:#15181e;color:#e3e6eb;font:14px ui-monospace,Consolas,'Cascadia Mono',monospace;transition:border-color 120ms;}.ds-input:hover{border-color:#444c5b;}.ds-input:focus-visible{outline:none;border-color:#5b9dff;box-shadow:0 0 0 2px #0e1014,0 0 0 4px #5b9dff;}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "The four views; current view in soft Cue Blue.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\">Show</a><a class=\"ds-nav-item\" href=\"#\">Venue Patch</a><a class=\"ds-nav-item\" href=\"#\">Profile Library</a><a class=\"ds-nav-item ds-current\" href=\"#\" aria-current=\"page\">Perform</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:4px;width:176px;padding:12px 8px;background:#15181e;border-right:1px solid #2f3541;font-family:'Segoe UI Variable Text','Segoe UI',system-ui,sans-serif;}.ds-nav-item{display:flex;align-items:center;height:32px;padding:0 8px;border-radius:6px;color:#9aa2b1;font-size:14px;font-weight:500;text-decoration:none;}.ds-nav-item:hover{background:#1c2028;color:#e3e6eb;}.ds-nav-item:focus-visible{outline:none;box-shadow:0 0 0 2px #0e1014,0 0 0 4px #5b9dff;}.ds-current,.ds-current:hover{background:rgb(91 157 255 / 16%);color:#5b9dff;}"
    },
    {
